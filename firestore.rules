rules_version = '2';

// Un document par joueur, lisible et modifiable par lui seul.
//
// Les écritures doivent partir de la dernière révision connue (révision + 1) :
// deux appareils qui envoient en même temps ne s'écrasent jamais, le second
// est refusé et réconcilie avant de renvoyer. Voir src/jeu/Compte.jsx.
service cloud.firestore {
  match /databases/{database}/documents {

    function proprietaire(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function formeValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['schema', 'revision', 'donnees', 'mine', 'maj', 'expire'])
        && d.keys().hasAll(['schema', 'revision', 'donnees', 'maj', 'expire'])
        && d.schema is int
        && d.revision is int
        && d.donnees is string && d.donnees.size() < 950000
        && (!('mine' in d) || d.mine == null || (d.mine is string && d.mine.size() < 60000))
        && d.maj == request.time
        && echeanceValide(d);
    }

    // Échéance de conservation (politique TTL sur `expire`). Le client la
    // calcule sur l'horloge de l'appareil (maintenant + cinq ans) : des bornes
    // serrées autour de cinq ans refusaient toute écriture d'un appareil dont
    // l'horloge dérivait de plus de deux semaines, en boucle. Elles ne font
    // qu'écarter l'absurde : entre un jour et dix ans.
    function echeanceValide(d) {
      return d.expire is timestamp
        && d.expire > request.time + duration.value(1, 'd')
        && d.expire < request.time + duration.value(3650, 'd');
    }

    match /joueurs/{uid} {
      allow read, delete: if proprietaire(uid);
      allow create: if proprietaire(uid) && formeValide()
        && request.resource.data.revision == 1;
      // Le format ne recule jamais : un onglet resté sur une ancienne version
      // du site ne réécrit pas par-dessus la partie d'une version plus récente.
      allow update: if proprietaire(uid) && formeValide()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.schema >= resource.data.schema;
    }

    // La ligne publique du classement : seulement pour qui a choisi d'y
    // figurer (voir src/succes/classement.js). Lisible par tout joueur
    // connecté, écrite par son seul propriétaire. Les bornes empêchent les
    // valeurs absurdes ; elles ne prétendent pas empêcher la triche, la
    // partie vivant dans le navigateur.
    //
    // Les valeurs des tables `extensions` et `premiers` ne sont pas typées :
    // le langage des règles ne sait pas parcourir une table de clés
    // quelconques. C'est le client qui les assainit à la lecture
    // (assainirLigne, src/succes/classement.js).

    function entierBorne(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    function ligneValide() {
      let d = request.resource.data;
      let champs = ['pseudo', 'titre', 'score', 'extensions', 'boosters', 'strate',
                    'succes', 'premiers', 'maj', 'expire'];
      return d.keys().hasOnly(champs) && d.keys().hasAll(champs)
        && d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 24
        && d.titre is string && d.titre.size() <= 80
        && entierBorne(d.score, 10000)
        && d.extensions is map && d.extensions.size() <= 40
        && d.premiers is map && d.premiers.size() <= 40
        && entierBorne(d.boosters, 1000000)
        && entierBorne(d.strate, 100000)
        && entierBorne(d.succes, 10000)
        && d.maj == request.time
        && echeanceValide(d);
    }

    match /classement/{uid} {
      allow read: if request.auth != null;
      allow create, update: if proprietaire(uid) && ligneValide();
      allow delete: if proprietaire(uid);
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
