{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "site",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "portraits",
      "public": "public/portraits",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.webp",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        },
        {
          "source": "/inventaire.json",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ]
    }
  ]
}
